#!/usr/bin/env bash
#
# run-scalac — build & run the Djinni generator WITHOUT Bazel.
#
# The generator is a plain Scala 2.11 program with three deps (scopt,
# scala-parser-combinators, snakeyaml). This compiles src/source/**/*.scala with
# scalac (JDK 8) and runs djinni.Main, so no Bazel/`src/run` is required anywhere
# in the Kotlin regeneration + coverage flow.
#
# Usage:
#   src/run-scalac [--rebuild] -- <djinni.Main args>
#   src/run-scalac -- --help
#
# Env (all have working defaults):
#   JAVA_HOME            JDK to use (Scala 2.11 needs JDK<=8; the Gradle djinni task sets a foojay-
#                        provisioned JDK 8 here). Falls back to `java` on PATH.
#   SCALA_VERSION        Scala 2.x for the generator + its compiler jars (default 2.11.12)
#   DJINNI_SCALAC_CACHE  where deps + compiled classes are cached (default src/.scalac-build)
set -euo pipefail

base_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)     # .../src
repo_dir=$(cd "$base_dir/.." && pwd)                        # djinni repo root
SRC="$repo_dir/src/source"

CACHE="${DJINNI_SCALAC_CACHE:-$base_dir/.scalac-build}"
LIBS_DIR="$CACHE/libs"
CLASSES_DIR="$CACHE/classes"
SCALA_VERSION="${SCALA_VERSION:-2.11.12}"

REBUILD=false
if [[ "${1:-}" == "--rebuild" ]]; then REBUILD=true; shift; fi
if [[ "${1:-}" == "--" ]]; then shift; fi

# --- JVM (Scala 2.11 needs JDK <= 8) ---------------------------------------
# Use the JDK handed in via $JAVA_HOME -- the Gradle djinni task provisions a JDK 8 toolchain (foojay)
# and sets it; fall back to `java` on PATH for a direct invocation. The Scala compiler itself is a
# Maven jar below, run on this JVM -- no sdkman, nothing installed imperatively.
JAVA="${JAVA_HOME:+$JAVA_HOME/bin/}java"

# --- dependency + Scala jars from Maven (the compiler is a plain dependency, run on $JAVA) ---------
mkdir -p "$LIBS_DIR"
# A plain function rather than an associative array: macOS still ships bash 3.2
# as /bin/bash, which has no `declare -A` -- it parses the string subscripts as
# arithmetic ("invalid arithmetic operator") and silently skips every download.
# This script runs at CMake configure time, so it has to work on a stock mac.
fetch_jar() { # <filename> <url>
  [ -f "$LIBS_DIR/$1" ] || curl -fsSL -o "$LIBS_DIR/$1" "$2"
}
fetch_jar "scopt_2.11-3.2.0.jar" \
  "https://repo1.maven.org/maven2/com/github/scopt/scopt_2.11/3.2.0/scopt_2.11-3.2.0.jar"
fetch_jar "scala-parser-combinators_2.11-1.0.1.jar" \
  "https://repo1.maven.org/maven2/org/scala-lang/modules/scala-parser-combinators_2.11/1.0.1/scala-parser-combinators_2.11-1.0.1.jar"
fetch_jar "snakeyaml-1.15.jar" \
  "https://repo1.maven.org/maven2/org/yaml/snakeyaml/1.15/snakeyaml-1.15.jar"
fetch_jar "scala-library-$SCALA_VERSION.jar" \
  "https://repo1.maven.org/maven2/org/scala-lang/scala-library/$SCALA_VERSION/scala-library-$SCALA_VERSION.jar"
fetch_jar "scala-reflect-$SCALA_VERSION.jar" \
  "https://repo1.maven.org/maven2/org/scala-lang/scala-reflect/$SCALA_VERSION/scala-reflect-$SCALA_VERSION.jar"
fetch_jar "scala-compiler-$SCALA_VERSION.jar" \
  "https://repo1.maven.org/maven2/org/scala-lang/scala-compiler/$SCALA_VERSION/scala-compiler-$SCALA_VERSION.jar"
SCALA_LIB="$LIBS_DIR/scala-library-$SCALA_VERSION.jar"
DEP_CP="$LIBS_DIR/scopt_2.11-3.2.0.jar:$LIBS_DIR/scala-parser-combinators_2.11-1.0.1.jar:$LIBS_DIR/snakeyaml-1.15.jar:$SCALA_LIB"
COMPILER_CP="$LIBS_DIR/scala-compiler-$SCALA_VERSION.jar:$LIBS_DIR/scala-reflect-$SCALA_VERSION.jar:$SCALA_LIB"

# --- compile (skip if built, unless --rebuild) -----------------------------
# scalac == `java -cp <scala-compiler> scala.tools.nsc.Main`, so no `scala`/`scalac` binary is needed.
if [ "$REBUILD" = true ] || [ ! -f "$CLASSES_DIR/djinni/Main.class" ]; then
  rm -rf "$CLASSES_DIR"; mkdir -p "$CLASSES_DIR"
  # shellcheck disable=SC2046
  "$JAVA" -cp "$COMPILER_CP" scala.tools.nsc.Main -cp "$DEP_CP" -d "$CLASSES_DIR" $(find "$SRC" -name '*.scala')
fi

exec "$JAVA" -cp "$CLASSES_DIR:$DEP_CP" djinni.Main "$@"
