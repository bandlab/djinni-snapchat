#!/usr/bin/env bash
#
# run-scalac — build & run the Djinni generator WITHOUT Bazel.
#
# The generator is a plain Scala 2.11 program with three deps (scopt,
# scala-parser-combinators, snakeyaml). This compiles src/source/**/*.scala with
# scalac (JDK 8) and runs djinni.Main, so no Bazel/`src/run` is required anywhere
# in the Kotlin regeneration + coverage flow.
#
# Usage:
#   src/run-scalac [--rebuild] -- <djinni.Main args>
#   src/run-scalac -- --help
#
# Env (all have working defaults):
#   JAVA_CANDIDATE   sdkman java candidate (default 8.0.502-zulu; Scala 2.11 needs JDK<=8)
#   SCALA_CANDIDATE  sdkman scala candidate (default 2.11.12)
#   DJINNI_SCALAC_CACHE  where deps + compiled classes are cached (default src/.scalac-build)
set -euo pipefail

base_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)     # .../src
repo_dir=$(cd "$base_dir/.." && pwd)                        # djinni repo root
SRC="$repo_dir/src/source"

CACHE="${DJINNI_SCALAC_CACHE:-$base_dir/.scalac-build}"
LIBS_DIR="$CACHE/libs"
CLASSES_DIR="$CACHE/classes"
JAVA_CANDIDATE="${JAVA_CANDIDATE:-8.0.502-zulu}"
SCALA_CANDIDATE="${SCALA_CANDIDATE:-2.11.12}"

REBUILD=false
if [[ "${1:-}" == "--rebuild" ]]; then REBUILD=true; shift; fi
if [[ "${1:-}" == "--" ]]; then shift; fi

# --- sdkman toolchain (Scala 2.11 needs JDK <= 8) --------------------------
if ! command -v sdk >/dev/null 2>&1; then
  export sdkman_auto_answer=true
  set +u; source "$HOME/.sdkman/bin/sdkman-init.sh"; set -u
fi
[ -d "$HOME/.sdkman/candidates/java/$JAVA_CANDIDATE" ]  || sdk install java  "$JAVA_CANDIDATE"  < /dev/null
[ -d "$HOME/.sdkman/candidates/scala/$SCALA_CANDIDATE" ] || sdk install scala "$SCALA_CANDIDATE" < /dev/null
sdk use java  "$JAVA_CANDIDATE"  >/dev/null
sdk use scala "$SCALA_CANDIDATE" >/dev/null
SCALA_LIB="$HOME/.sdkman/candidates/scala/$SCALA_CANDIDATE/lib/scala-library.jar"

# --- dependency jars (same three as src/BUILD) -----------------------------
mkdir -p "$LIBS_DIR"
declare -A JARS=(
  ["scopt_2.11-3.2.0.jar"]="https://repo1.maven.org/maven2/com/github/scopt/scopt_2.11/3.2.0/scopt_2.11-3.2.0.jar"
  ["scala-parser-combinators_2.11-1.0.1.jar"]="https://repo1.maven.org/maven2/org/scala-lang/modules/scala-parser-combinators_2.11/1.0.1/scala-parser-combinators_2.11-1.0.1.jar"
  ["snakeyaml-1.15.jar"]="https://repo1.maven.org/maven2/org/yaml/snakeyaml/1.15/snakeyaml-1.15.jar"
)
for name in "${!JARS[@]}"; do
  [ -f "$LIBS_DIR/$name" ] || curl -fsSL -o "$LIBS_DIR/$name" "${JARS[$name]}"
done
DEP_CP="$LIBS_DIR/scopt_2.11-3.2.0.jar:$LIBS_DIR/scala-parser-combinators_2.11-1.0.1.jar:$LIBS_DIR/snakeyaml-1.15.jar:$SCALA_LIB"

# --- compile (skip if built, unless --rebuild) -----------------------------
if [ "$REBUILD" = true ] || [ ! -f "$CLASSES_DIR/djinni/Main.class" ]; then
  rm -rf "$CLASSES_DIR"; mkdir -p "$CLASSES_DIR"
  # shellcheck disable=SC2046
  scalac -cp "$DEP_CP" -d "$CLASSES_DIR" $(find "$SRC" -name '*.scala')
fi

exec java -cp "$CLASSES_DIR:$DEP_CP" djinni.Main "$@"
